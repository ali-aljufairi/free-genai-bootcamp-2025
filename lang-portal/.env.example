# App
APP_ENV=local
PORT=8080

# Database (local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=sorami_user
DB_PASSWORD=your_password
DB_NAME=sorami
# Optional: DATABASE_URL=postgres://sorami_user:your_password@localhost:5432/sorami
POSTGRES_USER=sorami_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=sorami

# Clerk (dev app)
CLERK_ISSUER=https://clerk.your-dev-domain.com
CLERK_JWKS_URL=https://clerk.your-dev-domain.com/.well-known/jwks.json
CLERK_AUDIENCE=your-audience-claim
CLERK_SECRET_KEY=sk_test_...

# Auth behavior
ALLOW_DEV_FALLBACK_USER=0

# Seed data (local path to NDJSON bundle)
SEED_BUNDLE_PATH=/absolute/path/to/data/cleaned_json/db

# Legacy/blueprint DB (if needed)
BLUEPRINT_DB_URL=./words.db
