# Sorami lang-portal - Development commands
# Run from repo root for init/secrets; run from here for dev/build/db.

set dotenv-load
set shell := ["bash", "-uc"]
frontend_port := env('FRONTEND_PORT', '3000')

# Default: list recipes
default:
    @just --list

# === DEVELOPMENT ===

# Start backend with Air hot reloading
dev-backend:
    @echo "Starting backend with Air..."
    @lsof -ti:{{env('PORT', '8080')}} | xargs kill -9 2>/dev/null || true
    @if command -v air >/dev/null 2>&1; then air; else go install github.com/air-verse/air@latest && air; fi

# Start frontend with bun dev
dev-frontend:
    @echo "Starting frontend with bun on port {{frontend_port}}..."
    @lsof -ti:{{frontend_port}} | xargs kill -9 2>/dev/null || true
    @command -v bun >/dev/null 2>&1 || (echo "bun not found. Install: https://bun.sh/" && exit 1)
    cd frontend && PORT={{frontend_port}} bun run dev -- --port {{frontend_port}}

# Start both backend and frontend (run in separate terminals or use tmux)
dev:
    @echo "Run 'just dev-backend' in one terminal and 'just dev-frontend' in another"
    @echo "Or from inside tmux: tmux split-window -h 'just dev-backend'; tmux split-window -v 'just dev-frontend'"

# === BUILD & TEST ===

# Build the Go application
build:
    @echo "Building Go application..."
    CGO_ENABLED=1 go build -o main cmd/api/main.go

# Run Go tests
test:
    @echo "Running Go tests..."
    go test -v ./...

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    rm -f main build-errors.log build-errors.tmp dbtools

# === DATABASE - DOCKER ===

# Ensure DB_PORT matches a running Sorami DB, otherwise choose a free one
[private]
ensure-db-port:
    @test -f .env || (echo ".env not found. Run 'just init' from repo root." && exit 1)
    @DB_PORT_VALUE=${DB_PORT:-}; \
      RUNNING_DB_PORT=""; \
      RUNNING_CONTAINER_ID=""; \
      CONTAINER_NAME="${SORAMI_DB_CONTAINER_NAME:-sorami-postgres}"; \
      if [ -z "$DB_PORT_VALUE" ]; then \
          DB_PORT_VALUE=$(grep -E '^DB_PORT=' .env | tail -n1 | cut -d= -f2-); \
      fi; \
      if [ -z "$DB_PORT_VALUE" ]; then DB_PORT_VALUE=5432; fi; \
      if command -v docker >/dev/null 2>&1; then \
          RUNNING_CONTAINER_ID=$(docker ps --filter "name=$CONTAINER_NAME" --filter "status=running" -q | head -n1); \
          if [ -n "$RUNNING_CONTAINER_ID" ]; then \
              RUNNING_DB_PORT=$(docker port "$CONTAINER_NAME" 5432/tcp 2>/dev/null | tail -n1 | sed -E 's/.*:([0-9]+)$/\1/' || true); \
          fi; \
      fi; \
      if [ -n "$RUNNING_DB_PORT" ]; then \
          if [ "$RUNNING_DB_PORT" != "$DB_PORT_VALUE" ]; then \
              echo "Reusing running $CONTAINER_NAME on port $RUNNING_DB_PORT"; \
              bash "{{ justfile_directory() }}/../scripts/update-db-port.sh" .env "$RUNNING_DB_PORT"; \
          fi; \
      elif lsof -i:"$DB_PORT_VALUE" >/dev/null 2>&1; then \
          NEW_DB_PORT=$(bash "{{ justfile_directory() }}/../scripts/find-free-port.sh" "$DB_PORT_VALUE"); \
          if [ "$NEW_DB_PORT" != "$DB_PORT_VALUE" ]; then \
              echo "DB_PORT $DB_PORT_VALUE is busy; switching to $NEW_DB_PORT"; \
              bash "{{ justfile_directory() }}/../scripts/update-db-port.sh" .env "$NEW_DB_PORT"; \
          fi; \
      fi

# Start PostgreSQL database container
docker-up:
    @just ensure-db-port
    @echo "Starting PostgreSQL database..."
    @test -f Database/docker-compose.yml || (echo "Database/docker-compose.yml not found" && exit 1)
    @command -v docker >/dev/null 2>&1 || (echo "Docker not found." && exit 1)
    @if [ -f .env ]; then cd Database && docker compose --env-file ../.env up -d; else cd Database && docker compose up -d; fi
    @echo "Waiting for database to be ready..."
    @sleep 5
    @echo "Database started!"

# Stop PostgreSQL database container
docker-down:
    @echo "Stopping PostgreSQL database..."
    @test -f Database/docker-compose.yml || (echo "Database/docker-compose.yml not found" && exit 1)
    @if [ -f .env ]; then cd Database && docker compose --env-file ../.env down; else cd Database && docker compose down; fi

# Reset database (remove volumes, restart)
db-reset: docker-down
    @just ensure-db-port
    @if [ -f .env ]; then cd Database && docker compose --env-file ../.env down -v && docker compose --env-file ../.env up -d; else cd Database && docker compose down -v && docker compose up -d; fi
    @echo "Waiting for database to be ready..."
    @sleep 8
    @echo "Database reset complete!"

# === DATABASE - MIGRATIONS ===

# Run all pending migrations
db-migrate: db-migrate-up

db-migrate-up:
    @echo "Running database migrations..."
    go run cmd/migrate/main.go up

# Rollback last migration
db-migrate-down:
    @echo "Rolling back last migration..."
    go run cmd/migrate/main.go down

# Show migration status
db-migrate-status:
    @echo "Migration status:"
    go run cmd/migrate/main.go status

# === DATABASE - SEEDING ===

# Seed database with NDJSON files (requires SEED_BUNDLE_PATH in .env)
db-seed: db-seed-ndjson

db-seed-ndjson:
    @echo "Seeding database with NDJSON files..."
    @SEED_PATH="${SEED_BUNDLE_PATH:-{{ justfile_directory() }}/data/cleaned_json/db}"; \
      if [ ! -d "$SEED_PATH" ]; then \
          echo "Seed path not found: $SEED_PATH"; \
          echo "Set SEED_BUNDLE_PATH to override."; \
          exit 1; \
      fi; \
      if command -v psql >/dev/null 2>&1; then \
          WORDS_COUNT=$(PGPASSWORD="$DB_PASSWORD" psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -Atc "SELECT COUNT(*) FROM words" 2>/dev/null || true); \
          if [ -n "$WORDS_COUNT" ]; then \
              if [ "$WORDS_COUNT" -gt 0 ]; then \
                  echo "Words already present ($WORDS_COUNT). Skipping db-seed."; \
                  exit 0; \
              fi; \
          else \
              echo "Could not read word count; continuing with seeding."; \
          fi; \
      else \
          echo "psql not found; skipping pre-seed check."; \
      fi; \
      echo "Using seed path: $SEED_PATH"; \
      go run ./cmd/seed -path "$SEED_PATH"

# === DATABASE - FULL SETUP ===

# Complete setup: reset + migrate + seed
db-setup: db-reset
    @echo ""
    @just db-migrate-up
    @echo ""
    @just db-seed-ndjson
    @echo ""
    @echo "Database setup complete! Run 'just db-status' to verify."

# Validate database schema and seeded data
db-validate:
    @echo "Validating database schema and data..."
    go run ./cmd/validate

# Show database status (migrations + row counts)
db-status:
    @echo "=== Database Status ==="
    @echo ""
    @echo "Migration Status:"
    @just db-migrate-status 2>/dev/null || echo "Could not check migration status"
    @echo ""
    @echo "Row Counts:"
    @if [ -f .env ]; then . ./.env && PGPASSWORD="$DB_PASSWORD" psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -c "SELECT 'kanji' as table_name, COUNT(*) as count FROM kanji UNION ALL SELECT 'words', COUNT(*) FROM words UNION ALL SELECT 'grammar_points', COUNT(*) FROM grammar_points UNION ALL SELECT 'jlpt_questions', COUNT(*) FROM jlpt_questions UNION ALL SELECT 'item_relations', COUNT(*) FROM item_relations UNION ALL SELECT 'courses', COUNT(*) FROM courses UNION ALL SELECT 'units', COUNT(*) FROM units ORDER BY table_name;" 2>/dev/null || echo "Could not query database"; else PGPASSWORD='TempSorami!2025' psql -h localhost -p 5432 -U sorami_user -d sorami -c "SELECT 'kanji' as table_name, COUNT(*) as count FROM kanji UNION ALL SELECT 'words', COUNT(*) FROM words UNION ALL SELECT 'grammar_points', COUNT(*) FROM grammar_points UNION ALL SELECT 'jlpt_questions', COUNT(*) FROM jlpt_questions UNION ALL SELECT 'item_relations', COUNT(*) FROM item_relations UNION ALL SELECT 'courses', COUNT(*) FROM courses UNION ALL SELECT 'units', COUNT(*) FROM units ORDER BY table_name;" 2>/dev/null || echo "Could not query database"; fi
