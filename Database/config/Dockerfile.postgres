FROM postgres:17

# Metadata for the image
LABEL org.opencontainers.image.title="Sorami PostgreSQL"
LABEL org.opencontainers.image.description="PostgreSQL database with pgvector extension for Sorami language learning platform"
LABEL org.opencontainers.image.source="https://github.com/your-username/sorami"
LABEL org.opencontainers.image.licenses="MIT"

# Install pgvector extension - try to install from source if package not available
RUN apt-get update && \
    (apt-get install -y postgresql-17-pgvector || \
    (apt-get install -y build-essential git postgresql-server-dev-17 && \
    git clone https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make && \
    make install && \
    cd .. && \
    rm -rf pgvector)) && \
    rm -rf /var/lib/apt/lists/*

# Copy initialization scripts
COPY ../schema/pg.sql /docker-entrypoint-initdb.d/01-schema.sql
COPY ../schema/migration_learning_activities.sql /docker-entrypoint-initdb.d/02-migration-learning-activities.sql
COPY ../functions/hiragana_to_romaji.sql /docker-entrypoint-initdb.d/03-hiragana-to-romaji.sql
COPY ../schema/import_functions.sql /docker-entrypoint-initdb.d/04-import-functions.sql
COPY ../functions/user_tracking_functions.sql /docker-entrypoint-initdb.d/05-user-tracking-functions.sql
COPY ../indexes/user_management_indexes.sql /docker-entrypoint-initdb.d/06-user-management-indexes.sql
COPY ../functions/srs.sql /docker-entrypoint-initdb.d/07-srs.sql


# Set proper permissions
RUN chmod 644 /docker-entrypoint-initdb.d/*.sql

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres} || exit 1
