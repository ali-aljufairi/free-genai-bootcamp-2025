FROM postgres:17

# Metadata for the image
LABEL org.opencontainers.image.title="Sorami PostgreSQL"
LABEL org.opencontainers.image.description="PostgreSQL database with pgvector extension for Sorami language learning platform"
LABEL org.opencontainers.image.source="https://github.com/your-username/sorami"
LABEL org.opencontainers.image.licenses="MIT"

# Install pgvector extension - try to install from source if package not available
RUN apt-get update && \
    (apt-get install -y postgresql-17-pgvector || \
    (apt-get install -y build-essential git postgresql-server-dev-17 && \
    git clone https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make && \
    make install && \
    cd .. && \
    rm -rf pgvector)) && \
    rm -rf /var/lib/apt/lists/*

# Copy initialization scripts
COPY ../schema/pg.sql /docker-entrypoint-initdb.d/01-schema.sql
COPY ../schema/migration_learning_activities.sql /docker-entrypoint-initdb.d/02-migration-learning-activities.sql
COPY ../schema/migration_groups_user_ownership.sql /docker-entrypoint-initdb.d/03-migration-groups-user-ownership.sql
COPY ../functions/hiragana_to_romaji.sql /docker-entrypoint-initdb.d/04-hiragana-to-romaji.sql
COPY ../schema/import_functions/safe_json_extraction_functions.sql /docker-entrypoint-initdb.d/05-safe-json-extraction.sql
COPY ../schema/import_functions/text_processing_functions.sql /docker-entrypoint-initdb.d/06-text-processing.sql
COPY ../schema/import_functions/validation_functions.sql /docker-entrypoint-initdb.d/07-validation-functions.sql
COPY ../schema/import_functions/core_import_functions.sql /docker-entrypoint-initdb.d/08-core-import-functions.sql
COPY ../schema/import_functions/jlpt_questions_import.sql /docker-entrypoint-initdb.d/09-jlpt-questions-import.sql
COPY ../schema/import_functions/course_import_functions.sql /docker-entrypoint-initdb.d/10-course-import-functions.sql
COPY ../schema/import_functions/comprehensive_import_functions.sql /docker-entrypoint-initdb.d/11-comprehensive-import-functions.sql
COPY ../schema/import_functions/data_quality_functions.sql /docker-entrypoint-initdb.d/12-data-quality-functions.sql
COPY ../schema/import_functions/multi_kanji_compounds.sql /docker-entrypoint-initdb.d/13-multi-kanji-compounds.sql
COPY ../schema/import_functions/graph_building_functions.sql /docker-entrypoint-initdb.d/14-graph-building-functions.sql
COPY ../functions/user_tracking_functions.sql /docker-entrypoint-initdb.d/15-user-tracking-functions.sql
COPY ../indexes/user_management_indexes.sql /docker-entrypoint-initdb.d/16-user-management-indexes.sql
COPY ../indexes/graph_indexes.sql /docker-entrypoint-initdb.d/17-graph-indexes.sql
COPY ../functions/srs.sql /docker-entrypoint-initdb.d/18-srs.sql
COPY ../schema/study_activities_init.sql /docker-entrypoint-initdb.d/19-study-activities-init.sql
COPY ../schema/import_functions/word_builder_functions.sql /docker-entrypoint-initdb.d/20-word-builder-functions.sql


# Set proper permissions
RUN chmod 644 /docker-entrypoint-initdb.d/*.sql

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres} || exit 1
